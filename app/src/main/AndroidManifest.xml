<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- RecorderCtrl works fully offline: no INTERNET permission. Remove it (and network state) in case a library
         ever adds them; CI also checks the built APK has neither. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Recording, also with the screen off or in another app (foreground service, microphone). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The "Recording" notification with Pause and Stop. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fingerprint unlock for the app lock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Hides other apps' floating windows over the lock, PIN and delete/discard confirmation screens only.
         Install-time permission, no prompt. -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <!-- intentMatchingFlags (Android 16+): other apps can only start RecorderCtrl's exported screens with an
         intent that matches their filters (the launcher, and "Record audio" with RECORD_SOUND). -->
    <application
        android:name=".RecorderCtrlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:enableOnBackInvokedCallback="true"
        android:intentMatchingFlags="enforceIntentFilter"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.RecorderCtrl">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Record audio" for other apps; returns the recording and closes. -->
        <activity
            android:name=".RecordActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|density|uiMode"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="${applicationId}.record">
            <intent-filter>
                <action android:name="android.provider.MediaStore.RECORD_SOUND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".record.RecorderService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Hands one recording at a time to another app, when you share it. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- No downloadable emoji font: don't let androidx.emoji2 look one up from a font provider
             at start-up. Emoji are drawn with the phone's own emoji font instead. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
