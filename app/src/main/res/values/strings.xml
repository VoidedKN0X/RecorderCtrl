    <!-- Shell texts for this app -->
    <string name="settings_subtitle">Recording quality, microphone and privacy</string>
    <string name="app_lock_subtitle">Ask for an app PIN (and optionally your fingerprint) when opening RecorderCtrl. A recording that\'s running keeps going.</string>
    <string name="app_lock_footer">RecorderCtrl works fully offline: it has no internet permission, analytics or tracking. Recordings stay in its private storage until you share them or save a copy.</string>
    <string name="lock_prompt_subtitle">Your recordings</string>
    <string name="lock_forgot_body">The PIN can\'t be recovered. RecorderCtrl will delete all recordings kept in the app, reset its settings and turn the app lock off. Copies you saved to the Recordings folder are not deleted.</string>

