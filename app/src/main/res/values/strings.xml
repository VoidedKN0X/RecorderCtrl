    <!-- Speech to text: Settings -->
    <string name="group_transcription">Speech to text</string>
    <string name="transcription_footer">Transcripts are made on this phone with whisper.cpp and a model file you import. Nothing is uploaded: RecorderCtrl has no internet access. Bigger models are more accurate, but slower and need more memory.</string>
    <string name="model">Model</string>
    <string name="model_none">No model yet</string>
    <string name="model_import">Import a model</string>
    <string name="model_import_sub">Pick a whisper.cpp model file (ggml-….bin) you downloaded</string>
    <string name="model_replace">Replace the model</string>
    <string name="model_replace_sub">Pick another whisper.cpp model file; it replaces this one</string>
    <string name="model_where">Where do I get a model?</string>
    <string name="model_where_sub">Opens the whisper.cpp models page in your browser. ggml-base.bin is a good start; ggml-small.bin is more accurate.</string>
    <string name="model_delete">Delete the model</string>
    <string name="model_delete_title">Delete the model?</string>
    <string name="model_delete_body">%1$s (%2$s) is removed from RecorderCtrl. Transcripts you made are kept. Import a model again to transcribe.</string>
